# Django Core
DJANGO_SECRET_KEY=change-in-production-use-a-strong-secret-key-32chars
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Database Configuration
# For PostgreSQL with PostGIS in production/Docker:
# DATABASE_URL=postgis://postgres:postgres@localhost:5432/chargenearby
# Default local dev / test uses SQLite (with Haversine spatial engine):
DATABASE_URL=sqlite:///db.sqlite3

# Maps & Routing Provider (Optional API keys for OpenRouteService / Google Maps)
MAPS_API_KEY=
OR_SERVICE_URL=https://api.openrouteservice.org

# Pilot City Defaults
PILOT_CITY=Pune
PILOT_DEFAULT_LAT=18.5204
PILOT_DEFAULT_LNG=73.8567
PILOT_SEARCH_RADIUS_KM=5.0
